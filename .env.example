# ─────────────────────────────────────────────
# Culture Connects – Beispiel-Umgebungsvariablen
# Kopieren nach .env und mit echten Werten füllen.
# NIEMALS echte Secrets committen!
# ─────────────────────────────────────────────

# --- Allgemein ---
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# --- Backend / API ---
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Datenbank (PostgreSQL) ---
DATABASE_URL=postgresql://cc_user:cc_password@db:5432/culture_connects
POSTGRES_USER=cc_user
POSTGRES_PASSWORD=cc_password
POSTGRES_DB=culture_connects

# --- Async Queue (Redis / Celery) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- KI-Provider (hinter Adapter, Provider austauschbar) ---
# Im MVP kann ein Mock-Provider ohne Key genutzt werden.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
